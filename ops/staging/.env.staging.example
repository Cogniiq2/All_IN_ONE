# ════════════════════════════════════════════════════════════════════════════
# BoLaGio STAGING — configuration template. NO REAL VALUE BELONGS IN THIS FILE.
#
# Copy it to a git-ignored path — `.env.staging.local` (the ignore rules cover
# `.env` and `.env*.local`; a file named `.env.staging` would NOT be ignored) —
# fill it, validate it, then set every value in its store. The dotenv copy exists to be VALIDATED, not to be deployed: the
# worker reads Cloudflare vars/secrets, the Edge Function reads Supabase
# function secrets, n8n reads its own process environment.
#
#   node --experimental-strip-types ops/staging/validate-staging-config.mjs .env.staging.local
#
# This example file itself FAILS that validator by design: one PLACEHOLDER_VALUE
# violation per <…> placeholder (13 of them), exit 1. An unfilled copy must
# never pass; every other rule (APP_ENV, modes, gates, no NEXT_PUBLIC_) it passes. See ops/staging/secrets-checklist.md.
#
# Store legend, per variable:
#   [cf var]     plain var — declared in wrangler.jsonc `env.staging.vars`; do not `secret put` it
#   [cf secret]  `npx wrangler secret put <NAME> --env staging`
#   [edge]       `supabase secrets set <NAME>=…` on the staging project's Edge Function
#   [edge auto]  injected by Supabase into every Edge Function; never set by hand
#   [n8n env]    the n8n process environment, under the BOLAGIO_ prefix — see n8n/credentials-matrix.md
#   [psql]       a database setting written by ops/staging/cron.sql, not an env var
# ════════════════════════════════════════════════════════════════════════════

# ── Environment identity ─────────────────────────────────────────────────
# [cf var] Exactly `staging`. Anything else is read as production (fail-safe direction).
APP_ENV=staging

# ── Beds24 ───────────────────────────────────────────────────────────────
# [cf var] `live` on staging: real account, reads; writes only during the approved controlled validation.
BEDS24_MODE=live
# [cf secret] The account's refresh token. Per environment; never the production token on staging.
BEDS24_REFRESH_TOKEN=<set-with-wrangler-secret>
# [cf secret] Beds24's webhook verification token, if Beds24 is configured to send one. Optional on staging.
BEDS24_WEBHOOK_SECRET=<set-with-wrangler-secret>
# [cf var] The Beds24 status a PAID booking is promoted to. Default `confirmed`; set from the controlled validation (docs/beds24-contract.md §4 row 9).
BEDS24_CONFIRMED_STATUS=confirmed
# BEDS24_API_BASE_URL must NOT be set on staging (the validator refuses it; only a local deployment may point at a simulator).

# ── Supabase (the shared project — docs/supabase-shared-project.md) ──────
# [cf var] [edge auto] The project URL, https://<ref>.supabase.co. The Edge Function gets it injected.
SUPABASE_URL=https://<project-ref>.supabase.co
# [cf secret] [edge auto] The service-role JWT — or, with the optional bolagio_app role installed,
#             a JWT whose role claim is bolagio_app (same variable name, no code change).
#             The Edge Function keeps the injected service key; never `secrets set` this name there.
SUPABASE_SERVICE_ROLE_KEY=<set-with-wrangler-secret>
# [cf secret] The anon key; used by the admin sign-in only. Public by nature, still never NEXT_PUBLIC_.
SUPABASE_ANON_KEY=<set-with-wrangler-secret>

# ── PayPal (SANDBOX on staging; the four values must match in BOTH stores) ─
# [cf var] [edge] Exactly `sandbox`. `live` is refused on staging (LIVE_PAYPAL_ON_STAGING).
PAYPAL_MODE=sandbox
# [cf var] [edge] The sandbox app's client id. Public by nature (served to the browser by a route, never NEXT_PUBLIC_).
PAYPAL_CLIENT_ID=<sandbox-client-id>
# [cf secret] [edge] The sandbox app's secret.
PAYPAL_CLIENT_SECRET=<set-with-wrangler-secret-and-supabase-secrets-set>
# [cf secret] [edge] The id of the ONE webhook registered for the staging Edge Function URL.
PAYPAL_WEBHOOK_ID=<set-with-wrangler-secret-and-supabase-secrets-set>
# PAYPAL_SIMULATOR_URL must NOT be set on staging (refused; local only).

# ── Internal API shared secrets ──────────────────────────────────────────
# [cf secret] [n8n env as BOLAGIO_N8N_INTERNAL_SECRET] HMAC key n8n signs with. Same value in both places; different from production.
N8N_INTERNAL_SECRET=<set-with-wrangler-secret>
# [cf var] Seconds an n8n signature may be out of date. Default 300, clamped 30–900. Leave unset unless the n8n host clock drifts.
N8N_REPLAY_WINDOW_SECONDS=300
# [cf secret] [psql app.booking_sync_secret via ops/staging/cron.sql] The scheduler's shared secret for /api/booking/sync and /reconcile.
BOOKING_SYNC_SECRET=<set-with-wrangler-secret>
# [cf secret] Session HMAC for BoLaGio Control. At least 32 characters; the validator refuses shorter.
ADMIN_SESSION_SECRET=<set-with-wrangler-secret-at-least-32-characters>
# ADMIN_PREVIEW_DEMO, ADMIN_PREVIEW_EMAIL, ADMIN_PREVIEW_PASSWORD, ADMIN_DEV_FIXTURES must NOT be set on staging (refused).

# ── Gates (all closed by default) ────────────────────────────────────────
# [cf var] `false` except during the scripted sandbox end-to-end run (docs/paypal-sandbox-e2e.md); switch back afterwards.
DIRECT_BOOKING_ENABLED=false
# [cf var] Must not be `true` on staging: the refund saga would call PayPal; the refund contract is unproven.
PAYMENT_REFUND_EXECUTION_ENABLED=false
# [cf var] Must not be `true` on staging: cancelling a confirmed Beds24 reservation is unproven on the live account.
OPERATOR_PAID_CANCELLATION_ENABLED=false
# [cf var] Leave UNSET. A messaging rehearsal with the n8n `test` transport sets it to `true` and removes it afterwards
#          (the validator refuses a file that carries it). Never on production.
# MESSAGING_TEST_COMPLETIONS_ALLOWED=

# ── Guest messaging ──────────────────────────────────────────────────────
# [cf var] REQUIRED for any guest message to render: templates carry {{contactEmail}} and fail safely without it
#          (the delivery ledger records the refusal; nothing is sent). A staging mailbox, never the production one.
MESSAGING_CONTACT_EMAIL=<staging-contact-mailbox@example.invalid>
# [cf var] Optional. Rendered where a template carries {{contactPhone}}.
MESSAGING_CONTACT_PHONE=<optional-contact-phone>

# ── Booking clamps (optional; defaults in lib/booking/config.ts, clamped) ─
# [cf var] Minutes inventory is held while the guest pays. Default 15, clamp 5–120. The sandbox E2E case 15 uses 5.
BOOKING_HOLD_MINUTES=15
# [cf var] Seconds the local lock outlives one Beds24 POST. Default 120, clamp 30–600.
BOOKING_LOCK_SECONDS=120
# [cf var] Minutes before a reserving row is called stale regardless of lease. Default 180, clamp 30–1440.
BOOKING_STALE_HOLD_MINUTES=180
# [cf var] Seconds after hold_expires_at before a sweep may release. Default 120, clamp 30–900.
BOOKING_LEASE_GRACE_SECONDS=120
# [cf var] Months of inventory synchronised and browsable. Default 18, clamp 1–36.
BOOKING_INVENTORY_MONTHS=18
# [cf var] Minutes a live quote stays honest. Default 20, clamp 5–60.
BOOKING_QUOTE_MINUTES=20

# ── Not variables of the worker, listed so the picture is complete ───────
# [psql]    app.site_url            written by ops/staging/cron.sql (-v site_url=…); the worker's public URL
# [n8n env] BOLAGIO_SITE_URL, BOLAGIO_N8N_INTERNAL_SECRET, BOLAGIO_ENVIRONMENT=staging,
#           BOLAGIO_MESSAGING_TRANSPORT, BOLAGIO_MAIL_FROM, BOLAGIO_ALERT_TRANSPORT,
#           BOLAGIO_ALERT_WEBHOOK_URL, BOLAGIO_ALERT_EMAIL_TO, BOLAGIO_CLEANING_TRANSPORT,
#           BOLAGIO_CLEANING_WEBHOOK_URL, credential "BoLaGio SMTP" — n8n/credentials-matrix.md
# Nothing named NEXT_PUBLIC_* may appear in any staging configuration (refused).
