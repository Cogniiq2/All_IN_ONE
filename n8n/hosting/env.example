# Copy to /opt/bolagio-n8n/.env on the server, `chmod 600 .env`. Never commit
# the real file, never paste its values into a chat or a ticket.

# The n8n version the BoLaGio package was rehearsed on (see the runbook §2).
N8N_VERSION=

# Encrypts the credentials stored in n8n. Generate once (openssl rand -hex 32),
# keep a copy in your password manager: without it the SMTP credential is lost.
N8N_ENCRYPTION_KEY=

# ── BoLaGio STAGING package (n8n/workflows-staging) ──────────────────────
BOLAGIO_STAGING_SITE_URL=https://bolagio-staging.popovic-lazar0603.workers.dev
# Identical to N8N_INTERNAL_SECRET on the Cloudflare worker bolagio-staging.
BOLAGIO_STAGING_N8N_INTERNAL_SECRET=
BOLAGIO_STAGING_ENVIRONMENT=staging
# disabled → smtp only for the live test (the backend refuses `test` on staging).
BOLAGIO_STAGING_MESSAGING_TRANSPORT=disabled
BOLAGIO_STAGING_MAIL_FROM=
BOLAGIO_STAGING_ALERT_TRANSPORT=disabled
BOLAGIO_STAGING_CLEANING_TRANSPORT=disabled

# ── Later, for production (n8n/workflows, BOLAGIO_* without STAGING) ─────
# Added only at the production launch, on the same instance.
