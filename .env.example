# ════════════════════════════════════════════════════════════════════════════
# BoLaGio — environment
#
# Copy to `.env.local` for local development, and set the same keys as
# Cloudflare Worker secrets for preview and production:
#
#     npx wrangler secret put BEDS24_REFRESH_TOKEN
#
# ── The rule about NEXT_PUBLIC_ ────────────────────────────────────────────
# Anything prefixed NEXT_PUBLIC_ is compiled into the JavaScript every visitor
# downloads. Not one secret below carries that prefix, and none may be given
# one. Every value here is read through lib/booking/config.ts, which is
# `server-only` — importing it from a client component is a build error, which
# is the mechanism that keeps these out of the browser bundle.
#
# ── Where each of these has to be set ──────────────────────────────────────
# Next.js route handlers (the website)  → Cloudflare Worker secrets
# The PayPal webhook Edge Function      → Supabase function secrets, which are
#                                         a SEPARATE store. Setting a value in
#                                         Cloudflare does not set it there.
#                                         See docs/payment-paypal.md.
#
# Never commit real values. `.env` and `.env*.local` are already gitignored.
# ════════════════════════════════════════════════════════════════════════════

# ── Beds24 (channel manager) ───────────────────────────────────────────────
# API V2 only. The V1 apiKey/propKey scheme is deprecated and unused here.
BEDS24_API_BASE_URL=https://beds24.com/api/v2

# The long-lived refresh token from Beds24 → Settings → Account → API.
# Exchanged server-side for a short-lived access token; never sent to a browser.
BEDS24_REFRESH_TOKEN=

# 'mock' | 'live'.
#   mock  fixtures for development. The default when unset.
#   live  the real channel manager. A live deployment NEVER falls back to
#         fixtures — if Beds24 is unreachable the guest is told so.
BEDS24_MODE=mock

# Shared secret Beds24 presents on its booking webhook, sent as
# `x-bolagio-signature`. Without it, /api/webhooks/beds24 refuses everything.
BEDS24_WEBHOOK_SECRET=

# ── Supabase (BoLaGio-owned data) ──────────────────────────────────────────
SUPABASE_URL=

# Service role. Bypasses RLS, so it is server-side only, always.
# Every booking table has RLS enabled with no permissive policy: anon and
# publishable keys read nothing at all, deliberately, because these tables hold
# guest names, email addresses and phone numbers.
SUPABASE_SERVICE_ROLE_KEY=

# The status a PAID booking is promoted to at Beds24.
#
# Configurable because it is the one part of the Beds24 adapter the live test
# did NOT prove, and which statuses block inventory is a per-property setting
# rather than a universal rule. The finalizer reads the booking back and
# verifies it landed in this status, so a wrong value fails loudly into
# `finalization_failed` with the hold still in place — it never silently leaves
# a paid guest holding a reservation that does not block the night.
BEDS24_CONFIRMED_STATUS=confirmed

# ══════════════════════════════════════════════════════════════════════════
# PAYPAL
# ══════════════════════════════════════════════════════════════════════════
#
# ── PAYPAL_MODE fails closed ───────────────────────────────────────────────
# It must be EXACTLY `sandbox` or `live`. Anything else — unset, empty,
# `production`, a trailing space — means no payment is taken at all and the
# payment UI does not load.
#
# There is deliberately no default. `sandbox` would be safe for money and
# unsafe for truth: a production deployment that lost this value would take
# play-money payments, tell guests they had paid, and hold real inventory
# against them. `live` is obviously worse.
#
# The API base URL is DERIVED from this and is not configurable, because a
# settable base URL is one typo away from presenting sandbox credentials to
# the live API.
PAYPAL_MODE=sandbox

# From the PayPal Developer Dashboard, for the app matching PAYPAL_MODE.
# Sandbox and live credentials are NOT interchangeable.
#
# The client id is genuinely public — it identifies the merchant and
# authorises nothing — and is served to the browser by
# GET /api/booking/payment/config. It is not a NEXT_PUBLIC_ variable so that a
# deployment with the launch gate off serves no client id at all.
PAYPAL_CLIENT_ID=

# Server-side only, always. Never logged, never in an error, never in a
# response. If this ever appears in a browser bundle, rotate it immediately.
PAYPAL_CLIENT_SECRET=

# The id of the webhook registered in the PayPal dashboard.
#
# Required, and not optional in any environment: it is what binds a delivery to
# OUR webhook. Without it a valid PayPal signature from any other merchant's
# webhook would verify. Unset means every inbound event is refused.
PAYPAL_WEBHOOK_ID=

# ══════════════════════════════════════════════════════════════════════════
# n8n — automation, OUTSIDE the transactional core
# ══════════════════════════════════════════════════════════════════════════
#
# n8n claims durable events and sends messages. It cannot mark a booking paid
# or confirmed: there is no endpoint for it, and the database refuses a status
# change made anywhere but bolagio_booking_transition().
#
# Not a bearer token. Requests are signed HMAC-SHA256 over
# `v1:<timestamp>:<raw body>`, with a replay window, so a captured request is
# worth five minutes rather than forever. The exact algorithm, with a worked
# example, is in docs/n8n-booking-contract.md.
#
# Generate with:  openssl rand -hex 32
N8N_INTERNAL_SECRET=

# How far out of date a signature may be, in seconds. Clamped 30–900.
N8N_REPLAY_WINDOW_SECONDS=300

# ── Scheduled jobs ─────────────────────────────────────────────────────────
# The secret the inventory sync and the reconciliation pass present, as
# `x-bolagio-signature`, to POST /api/booking/sync and /api/booking/reconcile.
BOOKING_SYNC_SECRET=

# Legacy. Retained only so an existing deployment does not break on an unknown
# key; nothing reads it as payment authority any more. Payment truth comes from
# a PayPal signature-verified event or an authoritative server-side capture —
# see docs/booking-core-audit.md §2.1.
BOOKING_CALLBACK_SECRET=

# ══════════════════════════════════════════════════════════════════════════
# THE LAUNCH GATE
# ══════════════════════════════════════════════════════════════════════════
#
# Whether this deployment may create real direct bookings AT ALL.
#
# Fail-closed: anything other than the exact string `true` is off. Hiding the
# frontend button is not a gate — this is what a curl request runs into.
#
# It is the FIRST of two gates. The second is `bolagio_units.is_bookable` in
# the database, per unit. Both must be on.
#
# Do not set this to true until every item in
# docs/direct-booking-production-readiness.md is ticked.
DIRECT_BOOKING_ENABLED=false

# ── Booking behaviour ──────────────────────────────────────────────────────
# How long inventory is blocked at Beds24 while the guest pays. Clamped 5–120.
BOOKING_HOLD_MINUTES=15

# How far ahead inventory is synchronised and the calendar may be browsed.
# Clamped 1–36.
BOOKING_INVENTORY_MONTHS=18

# How long a live quote stays honest before it must be refetched. Clamped 5–60.
BOOKING_QUOTE_MINUTES=20

# How long the LOCAL lock is held while one Beds24 create is in flight.
#
# Not the guest-facing hold. It only has to outlast one POST with margin, and
# short matters: a lock whose owner died blocks those dates until it lapses.
# Clamped 30–600 seconds.
BOOKING_LOCK_SECONDS=120

# The backstop for bookings sitting in a reserving state far longer than a
# checkout takes. Reconciliation sweeps them; releasing still goes through the
# lease check, which refuses while any payment evidence exists.
# Clamped 30–1440 minutes.
BOOKING_STALE_HOLD_MINUTES=180

# How long AFTER hold_expires_at the sweep waits before it may release. The
# guest-facing gate (order creation, capture) closes exactly at the lease; the
# sweep opens only after this grace, so the two cannot cross. Clamped 30–900.
BOOKING_LEASE_GRACE_SECONDS=120

# ══════════════════════════════════════════════════════════════════════════
# BOLAGIO CONTROL — the operations interface at /admin
# ══════════════════════════════════════════════════════════════════════════
#
# See docs/admin-control.md. All three are server-side only; none is
# NEXT_PUBLIC_. Without the first two, sign-in is refused (fail-closed).

# Signs the operator session cookie. At least 32 characters.
# Generate with:  openssl rand -hex 32
ADMIN_SESSION_SECRET=

# The project's anon (publishable) key, used SERVER-SIDE to verify an
# operator's password against Supabase Auth. The browser never holds it.
SUPABASE_ANON_KEY=

# ── Development fixtures ───────────────────────────────────────────────────
# Serves synthetic data under `next dev` ONLY (dead code in a production
# build). Sign-in then accepts the fixture operator below; both values are
# required and there is no default password anywhere.
# ADMIN_DEV_FIXTURES=true
# ADMIN_DEV_FIXTURE_EMAIL=operator@example.com
# ADMIN_DEV_FIXTURE_PASSWORD=

# ══════════════════════════════════════════════════════════════════════════
# PREVIEW DEMO — looking at BoLaGio Control, and nothing else
# ══════════════════════════════════════════════════════════════════════════
#
# A Cloudflare preview is a PRODUCTION BUILD, so NODE_ENV proves nothing and
# is deliberately not consulted. The demo exists only when the deployment
# declares itself a preview AND the demo is explicitly switched on AND both
# credentials are present. Any one missing and there is no demo sign-in at
# all. See docs/admin-control.md §6.

# What this deployment is: local | preview | staging | production.
#
# Anything else — including unset — is read as PRODUCTION, so a worker that
# forgets this gets the safe answer. The four are validated against every
# other setting by lib/config/environment.ts: a contradiction (live PayPal on
# a preview, sandbox PayPal with direct booking on in production, the demo
# switch outside a preview, …) shuts the direct-booking gate whatever the flag
# says and is shown on the System page. Check before deploying with
#     node --experimental-strip-types scripts/check-env.mjs .env.production
# See docs/environments.md for the full matrix.
APP_ENV=local

# The demo switch. Only the exact string `true`. On a deployment where
# APP_ENV is not `preview` this does nothing whatsoever.
# ADMIN_PREVIEW_DEMO=true

# The demo credentials. No defaults anywhere. The password is also the
# material the demo session key is derived from — which is why a preview
# deployment needs NO production secret at all — so it is held to a
# secret's length: minimum 16 characters.
#   openssl rand -base64 24
# ADMIN_PREVIEW_EMAIL=
# ADMIN_PREVIEW_PASSWORD=
