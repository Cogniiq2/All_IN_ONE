# Cloudflare Workers Assets header rules.
#
# The only reason this file exists is a measured one: property photography was
# being served with `Cache-Control: public, max-age=0`, so every visit
# re-downloaded it. The derivatives under /media/ are content-addressed by size
# in their filename and are rewritten under a new name whenever the photography
# changes, so they can be cached hard.
#
# Nothing else is touched. HTML is deliberately absent from this file: it must
# keep revalidating so a deploy is visible immediately.

/media/*
  Cache-Control: public, max-age=31536000, immutable

# The reference imagery the units without their own photography still borrow.
/images/*
  Cache-Control: public, max-age=86400
